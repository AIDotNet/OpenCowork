<Project>
  <!-- Evaluated after each sidecar csproj, so these win over project-level
       Features=runtime-async=on and the net11 Microsoft.Data.Sqlite pin when
       OPEN_COWORK_COMPAT_WORKER republishes the same sources as net8. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Features></Features>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OpenCoworkCompatWorker)' == 'true'">
    <IlcInstructionSet>base</IlcInstructionSet>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Update="Microsoft.Data.Sqlite" Version="8.0.19" />
  </ItemGroup>

  <!-- VS 2022's ARM64 linker (MSVC 14.44) fatals on large Native AOT objects
       with LNK1322 (Cortex-A53 errata 843419). The suggested /Gy flag is a
       C/C++ COMDAT switch and does not apply to ILCompiler output. Windows on
       ARM PCs are not Cortex-A53; VS 2026 removed the check. Publish scripts
       only request lld-link on older VS (or an explicit override). When they
       do, replace MSVC link.exe after Native AOT resolves the VC toolchain
       and drop MSVC-only flags that standalone LLVM lld-link rejects. -->
  <Target Name="OpenCoworkUseLldLinkOnWinArm64"
          AfterTargets="SetupOSSpecificProps"
          Condition="'$(RuntimeIdentifier)' == 'win-arm64' and '$(PublishAot)' == 'true' and '$(OpenCoworkWinArm64Linker)' != ''">
    <PropertyGroup>
      <CppLinker>$(OpenCoworkWinArm64Linker)</CppLinker>
    </PropertyGroup>
    <Message Importance="High"
             Text="OpenCowork: linking win-arm64 Native AOT with $(CppLinker) to avoid MSVC LNK1322." />
  </Target>

  <Target Name="OpenCoworkStripLldIncompatibleLinkerArgs"
          BeforeTargets="LinkNative"
          Condition="'$(RuntimeIdentifier)' == 'win-arm64' and '$(PublishAot)' == 'true' and '$(OpenCoworkWinArm64Linker)' != ''">
    <ItemGroup>
      <_OpenCoworkLldUnsupportedLinkerArg Include="@(LinkerArg)"
        Condition="$([System.String]::Copy('%(Identity)').ToUpperInvariant().StartsWith('/SOURCELINK'))
                or $([System.String]::Copy('%(Identity)').ToUpperInvariant().StartsWith('-SOURCELINK'))
                or '$([System.String]::Copy('%(Identity)').ToUpperInvariant())' == '/NOEXP'
                or '$([System.String]::Copy('%(Identity)').ToUpperInvariant())' == '-NOEXP'
                or '$([System.String]::Copy('%(Identity)').ToUpperInvariant())' == '/NOIMPLIB'
                or '$([System.String]::Copy('%(Identity)').ToUpperInvariant())' == '-NOIMPLIB'" />
      <LinkerArg Remove="@(_OpenCoworkLldUnsupportedLinkerArg)" />
    </ItemGroup>
    <Message Importance="High"
             Condition="'@(_OpenCoworkLldUnsupportedLinkerArg)' != ''"
             Text="OpenCowork: dropped LLVM-incompatible linker args for lld-link: @(_OpenCoworkLldUnsupportedLinkerArg)" />
  </Target>
</Project>
