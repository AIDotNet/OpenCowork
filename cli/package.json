{
  "name": "@opencowork/cli",
  "version": "0.1.0",
  "description": "OpenCowork command-line interface",
  "type": "module",
  "private": true,
  "bin": {
    "opencowork": "./dist/index.js"
  },
  "files": ["dist", "README.md", "ARCHITECTURE.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:classic": "tsx src/index.ts --tui classic",
    "demo": "tsx src/index.ts --demo --tui classic",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.2.1",
    "react": "18.3.1",
    "react-devtools-core": "^4.28.5",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.28",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
