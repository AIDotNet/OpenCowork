{
  "name": "@aidotnet/opencowork",
  "version": "0.1.0",
  "description": "OpenCowork command-line interface",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIDotNet/OpenCowork.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/AIDotNet/OpenCowork/tree/main/cli",
  "bugs": {
    "url": "https://github.com/AIDotNet/OpenCowork/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "opencowork": "./dist/index.js",
    "cowork": "./dist/index.js"
  },
  "files": [
    "dist",
    "native-workers",
    "scripts",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.tsx",
    "dev:classic": "tsx src/index.tsx --tui classic",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "node ./scripts/install-native-worker.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@msgpack/msgpack": "^3.1.3",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "i18next": "^25.8.6",
    "ink": "^5.2.1",
    "marked": "^15.0.12",
    "react": "18.3.1",
    "react-devtools-core": "^4.28.5",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.28",
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
